{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/feedback/stats",
      "destination": "/api/feedback.js?stats=true"
    },
    {
      "source": "/api/feedback/:id",
      "destination": "/api/feedback.js?id=:id"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/feedback.js"
    }
  ]
}
